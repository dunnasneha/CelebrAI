# CelebrAI Environment Configuration
# Copy this file to .env and configure your values

# Flask Secret Key for session signing
SECRET_KEY=replace-with-a-random-secure-secret-key

# Server Port
PORT=5000

# Google Gemini API Key
# Obtain free from: https://aistudio.google.com/app/apikey
# If omitted, CelebrAI automatically runs in High-Fidelity Demo Mode
GEMINI_API_KEY=your_gemini_api_key_here
